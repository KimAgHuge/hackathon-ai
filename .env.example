# =========================================================
# 전체 실행에 필요한 설정 모음 (예시)
#
# 이 파일은 한곳에서 보기 위한 안내용입니다. 실제 값은 각 위치에 나눠 넣습니다.
#   - ai-server  : ai-server/.env (ai-server/.env.example 복사)
#   - backend    : 아래 DOENAAI_* 값을 환경변수로 지정 (또는 application-local.yml)
#   - frontend   : frontend/.env.local (frontend/.env.example 복사)
# .env 파일은 Git에 올리지 않습니다.
# =========================================================

# ---------------------------------------------------------
# 1. 두 서버가 반드시 같은 값을 써야 하는 항목
# ---------------------------------------------------------
# AI 서버 내부 호출 키 (32자 이상). 생성: cd ai-server && python -m app.security.internal_api_key
# ai-server/.env 와 백엔드 환경변수에 같은 값을 넣는다.
DOENAAI_AI_INTERNAL_API_KEY=

# ---------------------------------------------------------
# 2. backend (Spring Boot) 환경변수
# ---------------------------------------------------------
# 기본 프로필은 local 이며 backend/src/main/resources/application-local.yml 을 읽는다.
# (application-local.yml.example 을 복사해 Supabase 값을 채운다)
SPRING_PROFILES_ACTIVE=local
# AI 서버 주소. 다른 컴퓨터(Mac)에서 AI 서버를 돌리면 그 주소로 바꾼다. 예: http://192.168.0.90:8000
DOENAAI_AI_BASE_URL=http://localhost:8000
# 저장소 접속 정보를 암호화하는 키
DOENAAI_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------
# 3. ai-server (Mac 등 모델을 돌리는 컴퓨터) 핵심 설정 - 전체 목록은 ai-server/.env.example
# ---------------------------------------------------------
DOENAAI_OLLAMA_URL=http://127.0.0.1:11434
DOENAAI_AI_MODEL=qwen3.8:27b
# 화면에서 RAG를 고르면 관련 근거만 모델에 보낸다. 기본값은 true.
DOENAAI_AI_RAG_ENABLED=true
# 한글 요구사항과 영어 식별자를 이으려면 필요하다. 먼저 `ollama pull bge-m3` 를 실행한다.
# 비워 두면 낱말 일치 검색만 해서, 한글 요구사항은 대부분 "관련 근거 없음"이 된다.
DOENAAI_AI_EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------
# 4. frontend
# ---------------------------------------------------------
# frontend/.env.example 참고 (VITE_API_BASE_URL, VITE_AUTH_MODE, Supabase 값 등)
