{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpactAnalysis",
  "type": "object",
  "required": [
    "riskLevel",
    "riskScore",
    "impactAreas",
    "evidences",
    "recommendations"
  ],
  "properties": {
    "riskLevel": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "impactAreas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidences": {
      "type": "array"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}