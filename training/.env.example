# 실제 .env는 Git에 포함하지 않습니다. 이 파일을 training/.env로 복사한 뒤 값을 채우세요.
# AI 학습 서버에서 보이는 공유 폴더의 절대 경로입니다. 공백이 있으면 따옴표로 감쌉니다.
DOENAAI_TRAINING_SHARED_DIR="/absolute/path/to/shared-folder"
# AI 분석/추론 서버에 설정한 것과 같은 32자 이상 전송 키를 입력하세요.
DOENAAI_TRAINING_TRANSFER_KEY=
# 웹의 제한된 시험 학습을 허용할 때만 맥북 학습 서버의 로컬 MLX 모델 절대 경로를 입력합니다.
# 비워 두면 기존 자료 수신은 계속하고 학습 실행 요청만 거부합니다. 모델은 다운로드하지 않습니다.
DOENAAI_TRAINING_MODEL_DIR=
# 여러 분석 모델에 대응하는 로컬 MLX 모델 등록 파일의 절대 경로입니다.
# 비워 두면 위 경로를 Qwen 전용으로 사용합니다. 미등록 모델은 Qwen으로 대체하지 않습니다.
DOENAAI_TRAINING_MODELS_FILE=
# 완료 학습으로 새 분석 모델을 생성할 때만 학습 서버에 지정합니다.
# llama.cpp v0.7.0의 고정 revision 620d2225cc436ab0b001e3200e590e3b286ef9ab 체크아웃 경로입니다.
# convert_hf_to_gguf.py와 build/bin/llama-quantize가 필요하며 변경된 소스는 허용하지 않습니다.
DOENAAI_TRAINING_LLAMA_CPP_DIR=
# 위 변환 도구의 의존성이 설치된 별도 Python 3.10 이상 실행 파일의 절대 경로입니다.
# 공식 고정 도구의 requirements-convert_hf_to_gguf.txt를 사용하고 기존 학습 환경은 보존합니다.
# torch 2.11.0, transformers 4.57.6, numpy 2.2.6 이상 2.3 미만을 확인합니다.
DOENAAI_TRAINING_CONVERTER_PYTHON=
# 관리자가 빌드한 llama-quantize 실행 파일의 SHA-256을 입력합니다.
# 모델 생성에는 MLX-LM 0.32.0과 작업 폴더의 여유 공간 180 GiB 이상이 필요합니다.
DOENAAI_TRAINING_QUANTIZER_SHA256=
# 도구 자동 준비: python3 training/setup_model_export.py --python /absolute/path/to/python3
# 명령이 출력한 세 값을 이 파일에 반영한 뒤 학습 서버를 재시작합니다.
