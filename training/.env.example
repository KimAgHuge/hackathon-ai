# 실제 .env는 Git에 포함하지 않습니다. 이 파일을 training/.env로 복사한 뒤 값을 채우세요.
# AI 학습 서버에서 보이는 공유 폴더의 절대 경로입니다. 공백이 있으면 따옴표로 감쌉니다.
DOENAAI_TRAINING_SHARED_DIR="/absolute/path/to/shared-folder"
# AI 분석/추론 서버에 설정한 것과 같은 32자 이상 전송 키를 입력하세요.
DOENAAI_TRAINING_TRANSFER_KEY=
# 웹의 제한된 시험 학습을 허용할 때만 맥북 학습 서버의 로컬 MLX 모델 절대 경로를 입력합니다.
# 비워 두면 기존 자료 수신은 계속하고 학습 실행 요청만 거부합니다. 모델은 다운로드하지 않습니다.
DOENAAI_TRAINING_MODEL_DIR=
