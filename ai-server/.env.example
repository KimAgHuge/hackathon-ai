DOENAAI_OLLAMA_URL=http://127.0.0.1:11434
DOENAAI_AI_MODEL=qwen3.8:27b
# Generate once with: python -m app.security.internal_api_key
DOENAAI_AI_INTERNAL_API_KEY=
DOENAAI_AI_REQUEST_TIMEOUT_SECONDS=900
DOENAAI_AI_KEEP_ALIVE=30m
DOENAAI_AI_MAX_VALIDATION_RETRIES=1
# 승인·비식별 검토가 끝난 사례를 두 서버가 공유할 동기화 폴더의 절대 경로
DOENAAI_TRAINING_SHARED_DIR=
# AI 학습 서버에서 실행할 수신 API의 주소. 예: http://192.168.0.90:8011
DOENAAI_TRAINING_RECEIVER_URL=
# AI 학습 서버 수신 서비스에도 같은 값으로 설정할 32자 이상의 별도 키
DOENAAI_TRAINING_TRANSFER_KEY=
