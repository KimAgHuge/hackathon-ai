DOENAAI_OLLAMA_URL=http://127.0.0.1:11434
DOENAAI_AI_MODEL=qwen3.8:27b
# Generate once with: python -m app.security.internal_api_key
DOENAAI_AI_INTERNAL_API_KEY=
DOENAAI_AI_REQUEST_TIMEOUT_SECONDS=900
DOENAAI_AI_KEEP_ALIVE=30m
DOENAAI_AI_MAX_VALIDATION_RETRIES=1
# thinking과 모델 출력 길이는 기본 설정을 유지하고, DB 구조만 빠짐없이 나눠 검토한다.
DOENAAI_AI_DB_BATCH_MAX_CHARS=12000
DOENAAI_AI_DB_BATCH_MAX_TABLES=6
# 동일한 입력·모델의 검증된 단계 결과를 로컬에 서명 보관한다.
DOENAAI_AI_CHECKPOINTS_ENABLED=true
DOENAAI_AI_CHECKPOINT_MAX_AGE_SECONDS=86400
# 상세 DB 결과로 앞 단계의 미확인 설명·위험도 이유를 최종 정리한다.
DOENAAI_AI_FINAL_RECONCILIATION_ENABLED=true
# 근거가 확인된 관련 범위부터 검토하고, 입력 예산 안의 분할 결과는 한 번에 종합한다.
DOENAAI_AI_REQUIREMENT_FAST_PATH_ENABLED=true
# 종합 호출에 묶을 부분 결과의 글자 수 예산. 개별 결과를 잘라내지는 않는다.
DOENAAI_AI_DB_MERGE_MAX_CHARS=24000
# 빈 경로는 서버의 .runtime/model-selection.sqlite3를 사용한다. 저장소 밖으로 보내거나 Git에 넣지 않는다.
# 분석 서버에 같은 고정 버전의 MLX 기반 모델과 실행 환경을 준비한 경우에만 설정한다.
# 어댑터는 공유 폴더에서 검증한 뒤 로컬 저장소로 복사하며 운영 원본은 덮어쓰지 않는다.
DOENAAI_AI_MLX_MODEL_DIR=
DOENAAI_AI_MLX_PYTHON=
DOENAAI_AI_MLX_ADAPTER_DIR=
DOENAAI_AI_MODEL_STATE_FILE=
DOENAAI_AI_MODEL_ADMIN_TIMEOUT_SECONDS=10
DOENAAI_AI_MODEL_PROBE_TIMEOUT_SECONDS=60
DOENAAI_AI_MODEL_PROBE_TTL_SECONDS=300
# 승인·비식별 검토가 끝난 사례를 두 서버가 공유할 동기화 폴더의 절대 경로
DOENAAI_TRAINING_SHARED_DIR=
# AI 학습 서버에서 실행할 수신 API의 주소. 예: http://192.168.0.90:8011
DOENAAI_TRAINING_RECEIVER_URL=
# AI 학습 서버 수신 서비스에도 같은 값으로 설정할 32자 이상의 별도 키
DOENAAI_TRAINING_TRANSFER_KEY=
