# 로컬 개발 환경 설정 예시
#
# 사용 방법:
# 1. 이 파일을 복사해서 application-local.yml 생성
# 2. 아래 PLACEHOLDER 값을 실제 Supabase 프로젝트 값으로 변경
# 3. application-local.yml은 Git에 커밋하지 않음
#
# application-local.yml.example → Git 추적
# application-local.yml         → .gitignore 대상

spring:

  # ---------------------------------------------------------------------------
  # Supabase PostgreSQL
  # ---------------------------------------------------------------------------
  datasource:

    # Supabase Dashboard
    # → Connect
    # → Direct
    # → Session pooler
    # → JDBC
    #
    # Supabase에서 제공되는 JDBC URL의 user/password 부분은 아래
    # username/password 항목으로 분리해서 사용하는 것을 권장
    #
    # 예:
    # jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
    #
    # sslmode=require는 PostgreSQL 연결 시 TLS 사용을 강제하기 위한 옵션
    url: jdbc:postgresql://SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=require

    # Session pooler 사용 시 일반적으로:
    # postgres.PROJECT_REF
    username: postgres.PROJECT_REF

    # Supabase 프로젝트의 Database Password
    # 절대 Git에 커밋하지 말 것
    password: YOUR_DATABASE_PASSWORD

    driver-class-name: org.postgresql.Driver

    hikari:
      pool-name: DoenaaiHikariPool

      # 해커톤/로컬 개발 환경 기준 소규모 커넥션 풀
      maximum-pool-size: 5
      minimum-idle: 1

      # milliseconds
      connection-timeout: 10000
      validation-timeout: 5000

  # ---------------------------------------------------------------------------
  # Supabase Auth JWT
  # ---------------------------------------------------------------------------
  security:
    oauth2:
      resourceserver:
        jwt:

          # Supabase JWT의 iss(issuer) 검증에 사용
          #
          # 예:
          # https://abcdefghijk.supabase.co/auth/v1
          issuer-uri: https://PROJECT_REF.supabase.co/auth/v1

          # Supabase JWT 공개키(JWKS)
          #
          # Spring Boot가 Supabase Access Token의 서명을 검증할 때 사용
          jwk-set-uri: https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

          # 현재 doenaai Supabase 프로젝트의 JWT Signing Algorithm
          # JWKS의 alg 값과 일치해야 함
          #
          # 현재 프로젝트: ES256
          jws-algorithms:
            - ES256

          # Supabase 로그인 사용자의 Access Token aud 값
          audiences:
            - authenticated


# -----------------------------------------------------------------------------
# doenaai Application Settings
# -----------------------------------------------------------------------------
doenaai:

  # DB 연결 비밀번호를 AES-256-GCM으로 암호화할 때 사용하는 키
  #
  # 32바이트 난수 값을 Base64로 인코딩해서 환경변수로 주입
  # 예: openssl rand -base64 32
  security:
    credential-encryption-key: ${DOENAAI_CREDENTIAL_ENCRYPTION_KEY:}

  # Git 원격 조회 제한시간(초). 허용 호스트는 006 migration으로 생성되는
  # public.git_host_policies 테이블에서 관리
  git:
    connection-timeout-seconds: ${DOENAAI_GIT_CONNECTION_TIMEOUT_SECONDS:10}

  # Supabase 프로젝트 기본 URL
  #
  # 예:
  # https://abcdefghijk.supabase.co
  supabase:
    url: https://PROJECT_REF.supabase.co

  # AI 추론 서버
  #
  # 로컬 개발:
  # http://localhost:8000
  #
  # Mac Studio에서 AI 서버를 실행하는 경우:
  # http://MAC_STUDIO_IP:8000
  ai-server:
    base-url: http://localhost:8000
