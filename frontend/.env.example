# =========================================================
# 로컬 개발 기본값
# mock 모드는 백엔드와 Supabase 없이 화면을 바로 확인할 수 있습니다.
# 실제 Supabase 로그인 사용 시 VITE_AUTH_MODE=supabase로 변경하세요.
# =========================================================
VITE_AUTH_MODE=mock
VITE_AUTH_PROFILE_SOURCE=mock
VITE_USE_MOCK=true

VITE_MOCK_LOGIN_EMAIL=admin@doenaai.local
VITE_MOCK_LOGIN_PASSWORD=admin1234

# =========================================================
# Supabase Auth
# 실제 값으로 교체한 뒤 VITE_AUTH_MODE=supabase 사용
# publishable key 또는 anon key만 프론트에 등록
# service_role / secret key는 절대 등록하지 않음
# =========================================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# =========================================================
# Spring Boot API
# Vite proxy를 사용하면 /api 그대로 사용
# 직접 호출하려면 http://localhost:8080/api 형태로 변경
# =========================================================
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
